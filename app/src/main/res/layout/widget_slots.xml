<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Сегодня · 20 ноября"
            android:textColor="@color/w_ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="4 ч"
            android:textColor="@color/w_free"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:contentDescription="Шкала дня"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bar_preview" />

    <TextView
        android:id="@+id/slot1"
        style="@style/WidgetSlotRow"
        android:layout_marginTop="6dp"
        android:text="13:15–18:45   5 ч 30 мин" />

    <TextView
        android:id="@+id/slot2"
        style="@style/WidgetSlotRow"
        android:text="19:30–22:00   2 ч 30 мин" />

    <TextView
        android:id="@+id/slot3"
        style="@style/WidgetSlotRow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/slot4"
        style="@style/WidgetSlotRow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/slot5"
        style="@style/WidgetSlotRow"
        android:visibility="gone" />

    <TextView
        android:id="@+id/note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/w_muted"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
